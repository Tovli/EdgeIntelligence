{
  "name": "edge-intelligence-sdk",
  "version": "0.0.0-development",
  "description": "Edge-native LLM inference SDK for React Native and web",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Tovli/EdgeIntelligence",
  "author": "Tovli <opensource@tovli.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tovli/EdgeIntelligence.git"
  },
  "types": "./src/web/el_ffi.d.ts",
  "main": "./src/unsupported-node.cjs",
  "react-native": "./src/rn/index.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./src/rn/index.d.ts",
        "default": "./src/rn/index.ts"
      },
      "browser": {
        "types": "./src/web/el_ffi.d.ts",
        "default": "./src/web/el_ffi.js"
      },
      "types": "./src/web/el_ffi.d.ts",
      "default": "./src/unsupported-node.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "android/",
    "ios/",
    "react-native.config.js",
    "edge-intelligence-sdk.podspec",
    "README.md",
    "LICENSE"
  ],
  "codegenConfig": {
    "name": "EdgeIntelligenceSdkSpec",
    "type": "modules",
    "jsSrcsDir": "src/rn",
    "android": {
      "javaPackageName": "com.edgeintelligence"
    }
  },
  "scripts": {
    "test:rn-factory": "node typecheck/rn-factory-runtime-test.cjs",
    "typecheck:rn": "tsc --noEmit --project tsconfig.rn.json"
  },
  "dependencies": {
    "@ubjs/core": "0.31.0-3",
    "uniffi-bindgen-react-native": "0.31.0-3"
  },
  "peerDependencies": {
    "react": ">=19.2.0 <20",
    "react-native": ">=0.85.0 <0.87.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.2.4",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "typescript": "6.0.3"
  }
}
